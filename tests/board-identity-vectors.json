{
  "vectors": [
    {
      "name": "a board moves to a new port and keeps its identifier",
      "boards": [
        {"id": "usb-4113", "name": "ASIC 1", "client_port": 18110, "device_location": 4113, "serial": "serial-0"}
      ],
      "remembered_boards": [],
      "devices": [
        {"name": "ASIC", "location": 9001, "serial": "serial-0"}
      ],
      "expected_boards": [
        {"id": "usb-4113", "serial": "serial-0", "device_location": 9001}
      ]
    },
    {
      "name": "a move plus a new board at the old port gets a free identifier",
      "boards": [
        {"id": "usb-4113", "name": "ASIC 1", "client_port": 18110, "device_location": 4113, "serial": "serial-0"}
      ],
      "remembered_boards": [],
      "devices": [
        {"name": "ASIC", "location": 9001, "serial": "serial-0"},
        {"name": "ASIC", "location": 4113, "serial": "serial-1"}
      ],
      "expected_boards": [
        {"id": "usb-4113", "serial": "serial-0", "device_location": 9001},
        {"id": "usb-4113-1", "serial": "serial-1", "device_location": 4113}
      ]
    },
    {
      "name": "two boards swap ports and keep their identifiers",
      "boards": [
        {"id": "usb-4113", "name": "ASIC 1", "client_port": 18110, "device_location": 4113, "serial": "serial-0"},
        {"id": "usb-4114", "name": "ASIC 2", "client_port": 18111, "device_location": 4114, "serial": "serial-1"}
      ],
      "remembered_boards": [],
      "devices": [
        {"name": "ASIC", "location": 4114, "serial": "serial-0"},
        {"name": "ASIC", "location": 4113, "serial": "serial-1"}
      ],
      "expected_boards": [
        {"id": "usb-4113", "serial": "serial-0", "device_location": 4114},
        {"id": "usb-4114", "serial": "serial-1", "device_location": 4113}
      ]
    },
    {
      "name": "two boards with no serial stay distinct by location",
      "boards": [
        {"id": "usb-4113", "name": "ASIC 1", "client_port": 18110, "device_location": 4113},
        {"id": "usb-4114", "name": "ASIC 2", "client_port": 18111, "device_location": 4114}
      ],
      "remembered_boards": [],
      "devices": [
        {"name": "ASIC", "location": 4113},
        {"name": "ASIC", "location": 4114}
      ],
      "expected_boards": [
        {"id": "usb-4113", "device_location": 4113},
        {"id": "usb-4114", "device_location": 4114}
      ]
    },
    {
      "name": "a remembered board and a new board at the same port stay distinct",
      "boards": [],
      "remembered_boards": [
        {"id": "usb-4113", "name": "ASIC 1", "client_port": 18110, "device_location": 4113, "serial": "serial-0"}
      ],
      "devices": [
        {"name": "ASIC", "location": 4113, "serial": "serial-1"}
      ],
      "expected_boards": [
        {"id": "usb-4113-1", "serial": "serial-1", "device_location": 4113}
      ],
      "expected_remembered_boards": [
        {"id": "usb-4113", "serial": "serial-0", "device_location": 4113}
      ]
    }
  ]
}
