#!/usr/bin/env python3
"""Verify vendored file provenance and that Cargo uses the maintained upstream pin."""
import argparse, difflib, hashlib, json, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
VENDOR = ROOT / "integrations/dg-xch/vendor"
ORIGIN = ROOT / "integrations/dg-xch/vendor-origin.json"
MODIFIED = "Modified by Chia Network"
ADDED = "Added by Chia Network"

def fail(*messages):
    for message in messages:
        print(message, file=sys.stderr)
    raise SystemExit(1)

def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def vendor_files(root):
    return sorted(p.relative_to(root).as_posix() for p in root.rglob("*") if p.is_file())

def hash_tree(root):
    return {path: sha256(root / path) for path in vendor_files(root)}

def first_line(path):
    return path.read_text(errors="replace").splitlines()[0] if path.stat().st_size else ""

def check_tree(root, origin):
    manifest = origin.get("vendor_sha256")
    if not isinstance(manifest, dict):
        return ["vendor_sha256 is missing from vendor-origin.json; run --update"]
    current, source, problems = hash_tree(root), origin.get("source_sha256", {}), []
    for path in sorted(set(manifest) | set(current)):
        if path not in current:
            problems.append(f"missing vendor file: {path}")
        elif path not in manifest:
            problems.append(f"extra vendor file: {path}")
        elif current[path] != manifest[path]:
            problems.append(f"vendor hash mismatch: {path}")
    problems += [f"source_sha256 names missing file: {path}" for path in sorted(source)
                 if not (root / path).is_file()]
    for path, digest in sorted(current.items()):
        suffix = Path(path).suffix
        if suffix not in (".rs", ".toml"): continue
        if path not in source:
            if suffix == ".rs" and ADDED not in first_line(root / path):
                problems.append(f"missing change notice in added file: {path}")
        elif digest != source[path] and MODIFIED not in first_line(root / path):
            problems.append(f"missing change notice in modified file: {path}")
    return problems

def update_vendor_hashes(root, origin_path):
    origin = json.loads(origin_path.read_text())
    updated = {}
    for key, value in origin.items():
        if key != "vendor_sha256":
            updated[key] = value
        if key == "source_sha256":
            updated["vendor_sha256"] = hash_tree(root)
    if "vendor_sha256" not in updated: updated["vendor_sha256"] = hash_tree(root)
    origin_path.write_text(json.dumps(updated, indent=2) + "\n")

def diff_summary(root, checkout):
    print("Vendor diff against source checkout:")
    changed = False
    for path in vendor_files(root):
        target = checkout / path
        if not target.is_file():
            print(f"  only in vendor: {path}"); changed = True; continue
        if sha256(target) == sha256(root / path):
            continue
        try:
            diff = list(difflib.unified_diff(target.read_text().splitlines(),
                                             (root / path).read_text().splitlines(), lineterm=""))
        except UnicodeDecodeError:
            print(f"  binary differs: {path}"); changed = True; continue
        added = sum(line.startswith("+") and not line.startswith("+++") for line in diff)
        removed = sum(line.startswith("-") and not line.startswith("---") for line in diff)
        print(f"  {path}: +{added} -{removed}"); changed = True
    if not changed: print("  (no differences)")

def verify_source(root, origin, checkout):
    if not checkout.is_dir(): fail(f"Source checkout not found: {checkout}")
    print(f"Checking {origin.get('repository')}@{origin.get('revision')} in {checkout}")
    ok = bad = missing = 0; problems = []
    for path, expected in sorted(origin.get("source_sha256", {}).items()):
        target = checkout / path
        if not target.is_file():
            missing += 1; problems.append(f"missing source file: {path}")
        elif sha256(target) != expected:
            bad += 1; problems.append(f"source hash mismatch: {path}")
        else:
            ok += 1
    if problems:
        fail(f"Source verification failed: {ok} OK, {bad} bad, {missing} missing", *problems)
    print(f"Source verification: {ok} OK, {bad} bad, {missing} missing")
    diff_summary(root, checkout)

def require(condition, message):
    if not condition:
        fail(message)

def check_cargo(origin):
    packages = json.loads(subprocess.check_output(
        ["cargo", "metadata", "--locked", "--format-version", "1"],
        cwd=ROOT, text=True))["packages"]
    by_name = {}
    for package in packages:
        by_name.setdefault(package["name"], []).append(package)
    local = {"dg_xch_core": "core", "dg_xch_timelord": "timelord"}
    for name, directory in local.items():
        found = by_name.get(name, [])
        require(len(found) == 1, f"Expected one {name}, found {len(found)}")
        expected = (VENDOR / directory / "Cargo.toml").resolve()
        require(Path(found[0]["manifest_path"]).resolve() == expected,
                f"{name} is not the maintained local vendor copy")
        require(found[0]["source"] is None, f"{name} unexpectedly has source {found[0]['source']}")
    pin = origin["upstream_base"]
    for name, found in by_name.items():
        if not name.startswith("dg_") or name in local:
            continue
        require(len(found) == 1, f"Expected one {name}, found {len(found)}")
        source = found[0]["source"] or ""
        require(source.startswith("git+https://github.com/GalactechsLLC/dg_xch_utils?"),
                f"{name} is not from the upstream Git pin")
        require(source.endswith("#" + pin), f"{name} is not at the recorded upstream revision")

def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__); action = parser.add_mutually_exclusive_group()
    action.add_argument("--update", action="store_true", help="rewrite vendor_sha256 from the tree")
    action.add_argument("--source", metavar="CHECKOUT", help="verify against a local fork checkout")
    args = parser.parse_args(argv)
    if args.update:
        update_vendor_hashes(VENDOR, ORIGIN)
        print(f"Recorded vendor_sha256 for {len(hash_tree(VENDOR))} vendored files")
        return 0
    origin = json.loads(ORIGIN.read_text())
    if args.source:
        verify_source(VENDOR, origin, Path(args.source))
        return 0
    problems = check_tree(VENDOR, origin)
    if problems: fail("Vendor provenance check failed:", *problems)
    check_cargo(origin)
    print("Verified vendored hashes, change notices, and upstream dependency pin")
    return 0

if __name__ == "__main__":
    raise SystemExit(main())
