+// One shared pool bounds CPU use across concurrent challenge searches. The memo above
+// still coalesces identical challenges; proof-form (264-bit) searches remain serial.
+pub(crate) fn parallel_discriminant_prime(seed: &[u8], size_bits: usize) -> BigInt {
+    use std::sync::OnceLock;
+    const WORKERS: usize = 6;
+    static POOL: OnceLock<rayon::ThreadPool> = OnceLock::new();
+    let pool = POOL.get_or_init(|| {
+        rayon::ThreadPoolBuilder::new()
+            .num_threads(WORKERS)
+            .thread_name(|n| format!("discriminant-{n}"))
+            .build()
+            .expect("create discriminant worker pool")
+    });
+    let chunks = (size_bits / 8).div_ceil(32);
+    first_passing_in_order(pool, |index| {
+        // Add modulo the seed width, exactly matching repeated byte increments.
+        let mut sprout = seed.to_vec();
+        let mut carry = u128::from(index) * chunks as u128;
+        for byte in sprout.iter_mut().rev() {
+            carry += u128::from(*byte);
+            *byte = carry as u8;
+            carry >>= 8;
+        }
+        let mut bytes = Vec::with_capacity(size_bits / 8);
+        for _ in 0..chunks {
+            increment_big_endian(&mut sprout);
+            let hash = Sha256::digest(&sprout);
+            let count = (size_bits / 8 - bytes.len()).min(hash.len());
+            bytes.extend_from_slice(&hash[..count]);
+        }
+        let mut n = BigUint::from_bytes_be(&bytes);
+        for bit in [0, 1, 2, size_bits - 1] {
+            n.set_bit(bit as u64, true);
+        }
+        is_probable_prime(&n).then(|| BigInt::from_biguint(Sign::Plus, n))
+    })
+}
+
+fn first_passing_in_order<T: Send>(
+    pool: &rayon::ThreadPool,
+    test: impl Fn(u64) -> Option<T> + Sync,
+) -> T {
+    use rayon::prelude::*;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    let next = AtomicU64::new(0);
+    let best = AtomicU64::new(u64::MAX);
+    pool.install(|| {
+        (0..pool.current_num_threads())
+            .into_par_iter()
+            .filter_map(|_| {
+                loop {
+                    let index = next.fetch_add(1, Ordering::Relaxed);
+                    if index >= best.load(Ordering::Relaxed) {
+                        return None;
+                    }
+                    if let Some(value) = test(index) {
+                        best.fetch_min(index, Ordering::Relaxed);
+                        return Some((index, value));
+                    }
+                }
+            })
+            .min_by_key(|(index, _)| *index)
+            .expect("passing discriminant candidate")
+            .1
+    })
 }
 
