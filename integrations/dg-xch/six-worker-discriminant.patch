+            .build()
+            .unwrap();
+        for _ in 0..16 {
+            let found = first_passing_in_order(&pool, |index| {
+                if index == 1 {
+                    std::thread::sleep(std::time::Duration::from_millis(10));
+                }
+                (index == 1 || index == 4).then_some(index)
+            });
+            assert_eq!(found, 1);
