+    #[test]
+    fn parallel_matches_serial_for_sizes_seed_widths_and_counter_carry() {
+        let mut seeds = vec![vec![0], vec![255], vec![255; 32], vec![0; 32]];
+        for i in 0u64..64 {
+            seeds.push(Sha256::digest(i.to_be_bytes()).to_vec());
+        }
+        for bits in [16, 264, 512, 1024] {
