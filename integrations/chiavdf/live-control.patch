+static timelord_control::Channel live_control;
+static timelord_control::Point live_set(struct vdf_client *client, timelord_control::Point target)
+{
+    const double temperature = client->drv->GetPvtTemp();
+    if (!std::isfinite(temperature) || temperature <= 0 || temperature >= 55.)
+        throw std::runtime_error("temperature_guard");
+    uint8_t mask = 0;
+    for (int i=0; i<N_HW_VDFS; ++i)
+        if (client->conns[i].state == RUNNING) mask |= 1 << i;
+    auto read = [&]() { return timelord_control::Point{client->drv->GetPLLFrequency(), client->drv->GetBoardVoltage()}; };
+    auto voltage = [&](double v) {
+        if (client->drv->SetBoardVoltage(v)) throw std::runtime_error("voltage_write");
+        vdf_usleep(20000);
+    };
+    auto frequency = [&](double f) {
+        uint32_t index = 1;
+        while (index+1 < VALID_PLL_FREQS && pll_entries[index+1].freq <= f) ++index;
+        if (!client->drv->SetPLLFrequency(0.,index)) throw std::runtime_error("pll_write");
+    };
+    auto pause = [&](bool resume) {
+        if (!hw_vdf_control_checked(client->drv,mask,resume?1:0))
+            throw std::runtime_error("engine_control");
+    };
+    return timelord_control::apply(target,read,voltage,frequency,pause);
+}
